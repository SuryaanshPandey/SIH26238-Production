# Local development
SIH_STORAGE_BACKEND=sqlite
SIH_STORAGE_PATH=./data/sih26238.db
SIH_DOCUMENT_STORAGE_BACKEND=local
SIH_DOCUMENT_STORAGE_PATH=./data/documents

