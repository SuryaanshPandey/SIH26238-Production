# SIH26238 Rijvan Module Environment Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# Database Configuration
DATABASE_URL="file:./dev.db"

# Demo & Security Settings
DEMO_MODE=false
REAL_DATA_MODE=true
NSP_SOURCE_URL=https://scholarships.gov.in/All-Scholarships
NSP_SOURCE_TIMEOUT_MS=8000
LOG_LEVEL=info

# JAGO responsiveness guards
JAGO_HISTORY_TIMEOUT_MS=350
JAGO_CONTEXT_TIMEOUT_MS=3500
JAGO_RESPONSE_TIMEOUT_MS=7000
CONTRACT_VERSION=v1
JWT_SECRET=generate-a-strong-random-secret

# Cross-module integration providers
VERIFICATION_PROVIDER=http
DOCUMENT_PROVIDER=http
VERIFICATION_SERVICE_URL=http://127.0.0.1:8000
VERIFICATION_SERVICE_API_KEY=
DOCUMENT_SERVICE_URL=http://127.0.0.1:8000
STUDENT_APP_ORIGIN=http://localhost:3000
GOVERNMENT_BRIDGE_API_KEY=

# Protected-provider integration endpoints (configure after official onboarding; never commit secrets)
PFMS_PROVIDER_URL=
PFMS_PROVIDER_API_KEY=

# Official protected-source adapters. Leave blank until your organization completes onboarding.
NSP_SYNC_TTL_MS=900000
NSP_FAILURE_RETRY_MS=60000
SIH_SOURCE_DIGILOCKER_BASE_URL=
SIH_SOURCE_DIGILOCKER_API_KEY=
SIH_SOURCE_UDISE_PLUS_BASE_URL=
SIH_SOURCE_UDISE_PLUS_API_KEY=
SIH_SOURCE_APAAR_BASE_URL=
SIH_SOURCE_APAAR_API_KEY=
SIH_SOURCE_AISHE_BASE_URL=
SIH_SOURCE_AISHE_API_KEY=
SIH_SOURCE_UIDAI_BASE_URL=
SIH_SOURCE_UIDAI_API_KEY=
SIH_SOURCE_STATE_EDISTRICT_BASE_URL=
SIH_SOURCE_STATE_EDISTRICT_API_KEY=
SIH_SOURCE_UGC_NTA_BASE_URL=
SIH_SOURCE_UGC_NTA_API_KEY=
SIH_SOURCE_INSTITUTION_BASE_URL=
SIH_SOURCE_INSTITUTION_API_KEY=

# Optional DigiLocker / Meri Pehchaan authorization configuration. These require official partner onboarding.
DIGILOCKER_OAUTH_CLIENT_ID=
DIGILOCKER_OAUTH_CLIENT_SECRET=
DIGILOCKER_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/government/digilocker/callback
DIGILOCKER_OAUTH_AUTHORIZE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_OAUTH_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_USER_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/user

# Official OGD reference API (Open Government Data Platform India) fallback,
# used automatically by ReferenceDataService whenever the live LGD service
# (lgdirectory.gov.in) cannot be reached or parsed. Populate only after
# obtaining an API key and the correct LGD States/Districts resource UUIDs
# from data.gov.in — do not guess the resource IDs.
DATA_GOV_API_KEY=
LGD_OGD_STATES_RESOURCE_ID=
LGD_OGD_DISTRICTS_RESOURCE_ID=

# Official DigiLocker issued-document metadata endpoint. Override only if your approved partner integration uses another endpoint.
DIGILOCKER_ISSUED_DOCUMENTS_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/files/issued
DIGILOCKER_FETCH_TIMEOUT_MS=15000

SCHOLARSHIP_ACADEMIC_YEAR=2026-2027

SCHOLARSHIP_SOURCE_TIMEOUT_MS=9000

SCHOLARSHIP_DETAIL_TIMEOUT_MS=6500

SCHOLARSHIP_SOURCE_RETRIES=2

SCHOLARSHIP_MAX_DETAIL_PAGES=80
NSP_MAX_DETAIL_PAGES=100

SCHOLARSHIP_MAX_GENERIC_DETAIL_PAGES=20

MYSCHEME_SOURCE_URL=https://www.myscheme.gov.in/search

MYSCHEME_SITEMAP_URL=https://www.myscheme.gov.in/sitemap.xml

UGC_SOURCE_URL=https://www.ugc.gov.in/Home/student_Corner

MOTA_SOURCE_URL=https://tribal.nic.in/ScholarshiP.aspx

SOCIAL_JUSTICE_SOURCE_URL=https://socialjustice.gov.in/schemes

MOMA_SOURCE_URL=https://www.minorityaffairs.gov.in/

DEPWD_SOURCE_URL=https://depwd.gov.in/en/scholarship/

EDUCATION_SOURCE_URL=https://www.education.gov.in/national-scholarships-students

LABOUR_SOURCE_URL=https://labour.gov.in/
