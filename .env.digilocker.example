# Copy this file to .env.digilocker and fill in values from the official DigiLocker/API Setu partner onboarding.
# NEVER commit .env.digilocker or paste these secrets into source code.

DIGILOCKER_OAUTH_CLIENT_ID=
DIGILOCKER_OAUTH_CLIENT_SECRET=
# This must exactly match the callback registered with the partner application.
DIGILOCKER_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/government/digilocker/callback
